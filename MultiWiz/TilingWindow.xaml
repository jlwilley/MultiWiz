<Window x:Class="MultiWiz.TilingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MultiWiz - Tiling View"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="600"
        Background="#1e1e2e"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Layout button style -->
        <Style x:Key="LayoutButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active layout button style -->
        <Style x:Key="ActiveLayoutButtonStyle" TargetType="Button" BasedOn="{StaticResource LayoutButtonStyle}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Window badge style -->
        <Style x:Key="WindowBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Focus indicator border style -->
        <Style x:Key="FocusBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#a6e3a1"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#a6e3a1" ShadowDepth="0" BlurRadius="12" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with layout controls -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Layout selector buttons -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="Layout:" VerticalAlignment="Center"
                                   Foreground="#cdd6f4" FontWeight="Medium" Margin="0,0,12,0" FontSize="14"/>

                        <Button x:Name="BtnSingle" Content="Single"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="Single"/>

                        <Button x:Name="BtnSideBySide" Content="Side by Side"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="SideBySide"/>

                        <Button x:Name="BtnGrid2x2" Content="2×2 Grid"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="Grid2x2"/>

                        <Button x:Name="BtnThreeColumn" Content="3 Columns"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="ThreeColumn"/>

                        <Button x:Name="BtnPrimarySecondary" Content="Primary + Secondary"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="PrimarySecondary"/>

                        <Button x:Name="BtnSidebar" Content="Sidebar"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click" Tag="Sidebar"/>
                    </StackPanel>

                    <!-- Control buttons -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock x:Name="TxtWindowCount" Text="0 Windows"
                                   VerticalAlignment="Center" Foreground="#cdd6f4"
                                   Margin="0,0,16,0" FontSize="13"/>

                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Close Tiling View (Ctrl+T)"
                                Click="CloseButton_Click"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Thumbnail container -->
            <Grid Grid.Row="1" Background="#181825" Margin="0" x:Name="ThumbnailContainer">
                <!-- Canvas for DWM thumbnails (invisible but holds them) -->
                <Canvas x:Name="ThumbnailCanvas"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!-- Overlay canvas for visual elements (badges, borders) -->
                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        IsHitTestVisible="True"
                        MouseDown="OverlayCanvas_MouseDown"
                        ClipToBounds="True"/>

                <!-- Empty state message -->
                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="WindowRestore"
                                             Width="64" Height="64"
                                             Foreground="#45475a"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="No running game instances"
                               FontSize="18"
                               Foreground="#6c7086"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Launch games from the main window to see them here"
                               FontSize="13"
                               Foreground="#585b70"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
</Window>
