<Window x:Class="MultiWiz.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiWiz"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="MultiWiz" Height="450" Width="441" Icon="/magic-wand.ico">
    <materialDesign:DialogHost x:Name="AddDialog">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="16">
                <TextBlock Text="Add a new account" />

                <TextBox x:Name="AccountNameTextBox"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Account Name"/>

                <TextBox x:Name="UsernameTextBox"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Username"/>

                <TextBox x:Name="PasswordTextBox"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Password"/>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="DialogAddButton" Margin="0,8,8,0"
                        Content="ADD"
                        IsDefault="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="DialogAddButton_Click"/>


                    <Button x:Name="DialogCancelButton" Margin="0,8,8,0"
                        Content="CANCEL"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                            Click="DialogCancelButton_Click"/>

                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>
        <Grid x:Name="GridLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="369*"/>
                <RowDefinition Height="65*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="738*"/>
            </Grid.ColumnDefinitions>
            <ListView Name="AccountView" HorizontalContentAlignment="Stretch">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Account Name" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" />
                        <GridViewColumn Header="Running">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- Default value for false -->
                                                <Setter Property="Text" Value="✘" />
                                                <!-- When the condition is true -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="✔" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <Button Content="{materialDesign:PackIcon settings}" x:Name="SettingsButton" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource MaterialDesignFloatingActionLightButton}" Height="40" Width="40" />
                <Button x:Name="SwitchButton" Content="{materialDesign:PackIcon SwapHorizontal}" HorizontalAlignment="Left" Margin="240,0,0,0" VerticalAlignment="Center" Style="{DynamicResource MaterialDesignRaisedLightButton}" Click="SwitchButton_Click"/>
                <Button x:Name="DeleteButton" Content="{materialDesign:PackIcon delete}" HorizontalAlignment="Left" Margin="166,0,0,0" VerticalAlignment="Center" Style="{DynamicResource MaterialDesignRaisedLightButton}" Click="DeleteButton_Click"/>
                <Button Content="{materialDesign:PackIcon plus}" x:Name="AddButton" HorizontalAlignment="Left" Margin="92,0,0,0" VerticalAlignment="Center" Style="{DynamicResource MaterialDesignRaisedLightButton}" Click="AddButton_Click" />
                <Button x:Name="PlayButton" Content="{materialDesign:PackIcon play}" HorizontalAlignment="Left" Margin="18,0,0,0" VerticalAlignment="Center" Style="{DynamicResource MaterialDesignRaisedLightButton}" Click="PlayButton_Click"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
    
</Window>
