<Window x:Class="MultiWiz.Switcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiWiz"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Switcher" Height="30" Width="150" Background="{DynamicResource MaterialDesignPaper}" AllowsTransparency="True" Opacity="0.7" WindowStyle="None" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeToContent="Height" Topmost="True">

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <!-- Adjust the height as needed -->
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Style="{DynamicResource MaterialDesignRaisedLightButton}" 
        x:Name="CloseButton" 
        Content="{materialDesign:PackIcon Close}" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        Width="40" 
        Height="30" 
        Margin="0" 
        Padding="0"
        Click="CloseButton_Click"/>
        <Border BorderBrush="DarkSlateGray" BorderThickness="2" Grid.Row="1"/>
        <!-- Dynamic content area -->
            <ItemsControl x:Name="DynamicButtonsArea" Grid.Row="1">
                <!-- Items will be added dynamically in code-behind -->
            </ItemsControl>
        </Grid>

</Window>
