<Window x:Class="MultiWiz.Switcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiWiz"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Switcher" Height="30" Width="220" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeToContent="Height" Topmost="True" Icon="/magic-wand.ico">

    <Window.Resources>
        <!-- Catppuccin Mocha Color Palette -->
        <SolidColorBrush x:Key="CatppuccinBase" Color="#1e1e2e"/>
        <SolidColorBrush x:Key="CatppuccinMantle" Color="#181825"/>
        <SolidColorBrush x:Key="CatppuccinCrust" Color="#11111b"/>
        <SolidColorBrush x:Key="CatppuccinSurface0" Color="#313244"/>
        <SolidColorBrush x:Key="CatppuccinSurface1" Color="#45475a"/>
        <SolidColorBrush x:Key="CatppuccinSurface2" Color="#585b70"/>
        <SolidColorBrush x:Key="CatppuccinOverlay0" Color="#6c7086"/>
        <SolidColorBrush x:Key="CatppuccinText" Color="#cdd6f4"/>
        <SolidColorBrush x:Key="CatppuccinSubtext1" Color="#bac2de"/>
        <SolidColorBrush x:Key="CatppuccinSubtext0" Color="#a6adc8"/>
        <SolidColorBrush x:Key="CatppuccinMauve" Color="#cba6f7"/>
        <SolidColorBrush x:Key="CatppuccinLavender" Color="#b4befe"/>
        <SolidColorBrush x:Key="CatppuccinBlue" Color="#89b4fa"/>
        <SolidColorBrush x:Key="CatppuccinGreen" Color="#a6e3a1"/>
        <SolidColorBrush x:Key="CatppuccinTeal" Color="#94e2d5"/>
        <SolidColorBrush x:Key="CatppuccinPink" Color="#f5c2e7"/>

        <!-- Style for unmarked account buttons -->
        <Style x:Key="AccountCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinOverlay0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#11111b"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource CatppuccinText}"/>
                                <materialDesign:PackIcon x:Name="checkIcon"
                                                        Grid.Column="1"
                                                        Kind="CheckCircle"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource CatppuccinGreen}"
                                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for marked (active) account button -->
        <Style x:Key="MarkedAccountCardStyle" TargetType="Button" BasedOn="{StaticResource AccountCardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#cba6f7" Offset="0"/>
                        <GradientStop Color="#b4befe" Offset="0.5"/>
                        <GradientStop Color="#89b4fa" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinGreen}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6" Color="#cba6f7"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource CatppuccinBase}"
                                          FontWeight="SemiBold"/>
                                <materialDesign:PackIcon x:Name="checkIcon"
                                                        Grid.Column="1"
                                                        Kind="CheckCircle"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource CatppuccinBase}"
                                                        Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource CatppuccinBase}"
            CornerRadius="12"
            Padding="0"
            Opacity="0.98">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" Color="#11111b"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with close button -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#cba6f7" Offset="0"/>
                        <GradientStop Color="#b4befe" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="Quick Switch"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource CatppuccinBase}"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"/>

                <Button Grid.Column="1"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        x:Name="CloseButton"
                        Content="{materialDesign:PackIcon Close}"
                        Foreground="{StaticResource CatppuccinBase}"
                        Width="40"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Dynamic content area -->
            <ItemsControl x:Name="DynamicButtonsArea" Grid.Row="1" Margin="0,8,0,8">
                <!-- Items will be added dynamically in code-behind -->
            </ItemsControl>
        </Grid>
    </Border>

</Window>
