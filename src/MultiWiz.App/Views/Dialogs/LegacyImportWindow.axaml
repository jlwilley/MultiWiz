<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiWiz.App.ViewModels"
        x:Class="MultiWiz.App.Views.Dialogs.LegacyImportWindow"
        x:DataType="vm:LegacyImportViewModel"
        Title="MultiWiz"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CtpBaseBrush}"
        Foreground="{DynamicResource CtpTextBrush}">

  <StackPanel Margin="24" Spacing="16">
    <Grid ColumnDefinitions="Auto,*">
      <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top"
              Background="{DynamicResource CtpMauveSoftBrush}">
        <PathIcon Data="{StaticResource IconDownload}" Width="22" Height="22"
                  Foreground="{DynamicResource CtpMauveBrush}" />
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
        <TextBlock Classes="h2" Text="{Binding Heading}" TextWrapping="Wrap" />
        <TextBlock Classes="caption"
                   Text="MultiWiz found the accounts you saved in MultiWiz 3. Importing copies them, with their passwords, into this version. Your MultiWiz 3 files are left exactly as they are." />
      </StackPanel>
    </Grid>

    <Border Background="{DynamicResource CtpMantleBrush}" CornerRadius="8" Padding="6" MaxHeight="240">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Accounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LegacyAccountRow">
              <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding Username}" />
                    <TextBlock Classes="caption" Text="·" />
                    <TextBlock Classes="caption" Text="{Binding Realm}" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Classes="chip busy" IsVisible="{Binding !HasPassword}"
                        ToolTip.Tip="You can add the password later by editing the account.">
                  <TextBlock Text="No password" />
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Spacing="4" IsVisible="{Binding HasSettings}">
      <TextBlock FontWeight="Medium" Text="Settings that come along" />
      <TextBlock Classes="caption" Text="{Binding SettingsSummary}" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Classes="subtle" Content="Don't import"
              ToolTip.Tip="Start fresh; MultiWiz won't ask again"
              Command="{Binding DeclineCommand}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button MinWidth="96" Content="Not now" Command="{Binding LaterCommand}" />
        <Button MinWidth="120" Classes="primary" IsDefault="True" Content="Import" Command="{Binding ImportCommand}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
