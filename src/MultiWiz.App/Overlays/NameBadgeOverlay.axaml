<overlays:OverlayWindowBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:overlays="using:MultiWiz.App.Overlays"
                            xmlns:conv="using:MultiWiz.App.Converters"
                            x:Class="MultiWiz.App.Overlays.NameBadgeOverlay"
                            x:DataType="overlays:NameBadgeViewModel"
                            Title="MultiWiz">
  <Border Margin="2" Padding="4,4,12,4" CornerRadius="8"
          Background="{DynamicResource BadgeBackgroundBrush}"
          BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border MinWidth="22" Height="22" CornerRadius="5" Padding="6,0"
              Background="{Binding AccentColor, Converter={x:Static conv:AppConverters.AccentBrush}}">
        <TextBlock Text="{Binding Slot}" FontSize="12" FontWeight="Bold" Foreground="#11111B"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource BadgeForegroundBrush}" />
    </StackPanel>
  </Border>
</overlays:OverlayWindowBase>
