<!--
  Shared MultiWiz styles on top of the Fluent theme.
  Spacing scale: 4, 8, 12, 16, 24, 32. Corner radii: 6 (controls), 10 (cards), 999 (chips).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource CtpSubtextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOverlayBrush}" />
  </Style>
  <Style Selector="TextBlock.setting-title">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource CtpRedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CtpBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CtpSurface0Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="Border.dot">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.slot">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.slot TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource CtpSubtextBrush}" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CtpSubtextBrush}" />
  </Style>
  <Style Selector="Border.chip.ok">
    <Setter Property="Background" Value="{DynamicResource CtpGreenSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CtpGreenBrush}" />
  </Style>
  <Style Selector="Border.chip.busy">
    <Setter Property="Background" Value="{DynamicResource CtpYellowSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.busy TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CtpYellowBrush}" />
  </Style>
  <Style Selector="Border.chip.error">
    <Setter Property="Background" Value="{DynamicResource CtpRedSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CtpRedBrush}" />
  </Style>
  <Style Selector="Border.chip.info">
    <Setter Property="Background" Value="{DynamicResource CtpBlueSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.info TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CtpBlueBrush}" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource CtpMauveSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CtpMauveBrush}" />
  </Style>

  <!-- Icons -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource CtpMauveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnMauveBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpMauveHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnMauveBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpMauvePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnMauveBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource CtpRedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnRedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpRedHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnRedBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpRedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpOnRedBrush}" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpSurface1Brush}" />
  </Style>
  <Style Selector="Button.subtle.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpRedSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpRedBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="3" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="Button.small PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CtpMauveBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CtpMauveHoverBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CtpMauvePressedBrush}" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpMauveSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpMauveBrush}" />
  </Style>

  <!-- Selectable tiles (team list, layout picker, colour swatches) -->
  <Style Selector="ListBox.tiles">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CtpSurface0Brush}" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource CtpMauveBrush}" />
  </Style>
  <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpMauveSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>

  <Style Selector="ListBox.list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.list ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="ListBox.list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpSurface0Brush}" />
  </Style>
  <Style Selector="ListBox.list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CtpMauveSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CtpTextBrush}" />
  </Style>

  <!-- Settings tabs -->
  <Style Selector="TabControl.sections TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
</Styles>
